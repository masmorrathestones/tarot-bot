OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-luna
DATABASE_URL=postgresql+psycopg://tarot:tarot@localhost:5432/tarot_bot

# Public URL used when WhatsApp needs to fetch image media from this API.
PUBLIC_BASE_URL=https://tarot-bot-c1fv.onrender.com

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tarot price in the smallest currency unit (cents). Defaults are US$1.00 and R$6.00.
TAROT_PRICE_USD_CENTS=100
TAROT_PRICE_BRL_CENTS=600

# Daily Tarot + Weekly Astrology plan prices.
# Recurring monthly plan: US$10 / R$60. One-month non-renewing plan: US$11 / R$66.
PLAN_RECURRING_USD_CENTS=1000
PLAN_RECURRING_BRL_CENTS=6000
PLAN_ONE_TIME_USD_CENTS=1100
PLAN_ONE_TIME_BRL_CENTS=6600
# The application scheduler checks for due plan deliveries while the API process is running.
PLAN_SCHEDULER_ENABLED=true
PLAN_SCHEDULER_INTERVAL_SECONDS=60

# WhatsApp Cloud API
# Choose any long random string here, then use the same value in Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Example: vXX.X. Set this to the Graph API version shown in your Meta app/docs.
WHATSAPP_GRAPH_VERSION=
# Optional but strongly recommended in production for X-Hub-Signature-256 validation.
WHATSAPP_APP_SECRET=

# X / Twitter scheduler and prospecting
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# App Bearer Token used by GET /2/tweets/search/recent.
X_BEARER_TOKEN=
# Protects the scheduler/prospecting admin endpoints.
X_SCHEDULER_ADMIN_TOKEN=change-me
X_SCHEDULER_ENABLED=true
X_SCHEDULER_INTERVAL_SECONDS=30
# Prospecting performs a recent-search cycle every 2 hours by default.
X_PROSPECTING_ENABLED=true
X_PROSPECTING_INTERVAL_SECONDS=7200
X_PROSPECTING_MIN_SCORE=5
X_PROSPECTING_MAX_PER_RUN=5
# Optional custom searches separated by ||. Leave empty to use PT/EN/ES defaults.
X_PROSPECT_QUERIES=
