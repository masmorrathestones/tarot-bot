OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-luna
DATABASE_URL=postgresql+psycopg://tarot:tarot@localhost:5432/tarot_bot

# WhatsApp Cloud API
# Choose any long random string here, then use the same value in Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Example: vXX.X. Set this to the Graph API version shown in your Meta app/docs.
WHATSAPP_GRAPH_VERSION=
# Optional but strongly recommended in production for X-Hub-Signature-256 validation.
WHATSAPP_APP_SECRET=
